# Copy to .env.local for local use. Leave DATABASE_URL empty to use the built-in local database.

# Supabase → your project → Connect → "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
# Set the same value in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=

# Any long random string. Download all answers as CSV at /api/export?key=<this>.
# Locally it defaults to "dev". On Vercel the export is off until this is set.
EXPORT_KEY=
